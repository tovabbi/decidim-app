<% if organization %>
  <% if defined?(custom_url_for_mail_root) && custom_url_for_mail_root.present? %>
    <% url = custom_url_for_mail_root %>
  <% else %>
    <% url = decidim.root_url(host: organization.host) %>
  <% end %>
  <%= link_to url do %>
    <% if organization.logo.attached? %>
      <%# Permanent redirect URL: the direct disk URL from variant_url expires, so logos vanished from older emails %>
      <%= image_tag(
            Rails.application.routes.url_helpers.rails_representation_url(
              organization.attached_uploader(:logo).variant(:medium), host: organization.host, protocol: "https"
            ),
            style: "max-height: 50px",
            alt: organization_name(organization)
          ) %>
    <% else %>
      <span><%= organization_name(organization) %></span>
    <% end %>
  <% end %>
<% else %>
  <%= Decidim.application_name %>
<% end %>
